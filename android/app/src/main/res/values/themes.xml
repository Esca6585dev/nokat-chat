<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base window theme. All UI is drawn by Jetpack Compose (Material 3). -->
    <style name="Theme.Nokat" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/nokat_window_background</item>
        <item name="android:colorAccent">@color/nokat_primary</item>
    </style>

    <!-- Launch theme (androidx.core:core-splashscreen). -->
    <style name="Theme.Nokat.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nokat_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Nokat</item>
    </style>
</resources>
