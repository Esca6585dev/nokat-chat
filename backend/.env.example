ADDR=:8080
# sqlite (default, zero setup) or postgres
DB_DRIVER=sqlite
DB_DSN=nokat.db
# DB_DRIVER=postgres
# DB_DSN=postgres://nokat:nokat@localhost:5432/nokat?sslmode=disable
JWT_SECRET=please-change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
# true: OTP code is returned in the API response and logged (development only!)
OTP_DEV_MODE=true
# Optional SMS gateway: receives POST {"phone": "+993...", "text": "..."}
SMS_WEBHOOK_URL=
